VITE_API_URL=http://localhost:5000/api
VITE_APP_URL=http://localhost:5173
VITE_TURNSTILE_SITE_KEY=replace_me
VITE_GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

# Optional overrides for the Cloudflare Pages Functions in `functions/`. These are
# read at request time via `context.env` (set them as Pages environment variables),
# not inlined at build time like the VITE_* values above. Production defaults
# already point at the Render API and veylo.com.ng.
VEYLO_API_ORIGIN=https://veylo-api-ptk3.onrender.com
VEYLO_WEB_ORIGIN=https://veylo.com.ng
