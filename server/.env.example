NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_password
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/veylo?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_bytes
OTP_SECRET=replace_with_a_different_32_byte_random_value

RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Veylo <info@veylo.com.ng>
TURNSTILE_SECRET_KEY=replace_me
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com

R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=veylo-media

# Optional delivery preview worker. See cloudflare/delivery-images/README.md.
R2_IMAGE_WORKER_URL=
R2_IMAGE_WORKER_SECRET=

# Enable after deploying the media Worker, music catalogue and updated apps.
# See docs/cloudflare-media-offload.md. Workers Paid is required; no Containers.
R2_MEDIA_OFFLOAD_ENABLED=false

# Optional, one-time only. Used by the migration command before Cloudinary is removed.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PRO_PLAN_CODE=PLN_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:5173/billing
BILLING_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

DELIVERY_PIPELINE_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Developer plan starting allowances; response headers refine the token budget.
GROQ_REQUESTS_PER_MINUTE=1000
GROQ_TOKENS_PER_MINUTE=250000
AI_ANALYSIS_CONCURRENCY=100
AI_WRITING_CONCURRENCY=30
AI_ASSISTANT_CONCURRENCY=8
AI_OTHER_CONCURRENCY=8
# Switch the API to external only after the separate delivery worker is running.
DELIVERY_WORKER_MODE=inline
ALIBABA_FALLBACK_MODEL=deepseek-v4.1-flash
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_WORKSPACE_ID=
ALIBABA_BASE_URL=
DELIVERY_WORKER_CONCURRENCY=4
DELIVERY_V3_WORKER_CONCURRENCY=100
DELIVERY_AI_CONCURRENCY=6
DELIVERY_VISION_BATCH_SIZE=3
DELIVERY_CAPTION_BATCH_SIZE=8
DEEPGRAM_API_KEY=replace_me

# Content Studio uses Groq for creative text and vision, with Alibaba as its AI fallback. Alibaba is also required for Qwen Image generation; Deepgram handles narration and Cloudflare R2 stores media.
# Run on your PC with: npm run content:local
CONTENT_VOICE_MODEL=flux-hannah-en
CONTENT_DAILY_UNITS=150
CONTENT_RENDER_CONCURRENCY=2
# Optional installed Chrome / Chromium executable. Blank uses Remotion's browser.
CONTENT_BROWSER_EXECUTABLE=
