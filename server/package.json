{
  "name": "cine-story-server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "studio-names:audit": "node scripts/studio-names.mjs",
    "studio-names:migrate": "node scripts/studio-names.mjs --apply",
    "verify:studio-names": "node --test scripts/studio-names.test.mjs",
    "start": "node server.js",
    "verify:syntax": "node scripts/verify-syntax.mjs",
    "dev": "nodemon server.js",
    "delivery:worker": "node delivery-worker.js",
    "content:worker": "node content-worker.js",
    "render": "node content-worker.js",
    "content:local": "node content-local.js",
    "admin:create": "node scripts/createAdmin.js",
    "verify:client-ip": "node scripts/verify-client-ip.mjs",
    "verify:delivery-v2": "node scripts/verify-delivery-v2.mjs",
    "verify:delivery-v3": "node --test scripts/delivery-v3.test.mjs scripts/purpose-wording.test.mjs",
    "verify:soundtracks": "node scripts/verify-soundtrack-catalogue.mjs",
    "verify:analytics": "node scripts/verify-analytics-privacy.mjs",
    "verify:email-system": "node scripts/verify-email-system.mjs",
    "verify:billing": "node --test scripts/billing-regression.test.mjs scripts/billing-edge.test.mjs",
    "billing:audit": "node scripts/billing-migrate.mjs",
    "billing:migrate": "node scripts/billing-migrate.mjs --apply",
    "verify:billing-admin": "node scripts/verify-billing-admin.mjs",
    "verify:admin-account-delete": "node scripts/verify-admin-account-delete.mjs",
    "verify:assistant": "node scripts/verify-assistant.mjs && node --test scripts/assistant-chat.test.mjs",
    "verify:content-studio": "node scripts/verify-content-studio.mjs",
    "verify:security": "node scripts/security-audit-delivery-v2.mjs",
    "verify:smoke": "node scripts/verify-production-smoke.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "resend": "^6.28.0",
    "sharp": "0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
