        "type": "string"
      },
      "zoomTargets": {
        "maxItems": 5,
        "type": "array",
        "items": {
          "$ref": "#/definitions/__schema0"
        }
      },
      "caption": {
        "type": "string",
        "maxLength": 160
      }
    },
    "required": [
      "clipId",
      "zoomTargets",
      "caption"
    ],
    "additionalProperties": false,
    "definitions": {
      "__schema0": {
        "type": "string"
      }
    }
  },
  "example": {
