        "maxLength": 180
      },
      "emphasis": {
        "maxItems": 4,
        "type": "array",
        "items": {
          "$ref": "#/definitions/__schema0"
        }
      }
    },
    "required": [
      "text",
      "emphasis"
    ],
    "additionalProperties": false,
    "definitions": {
      "__schema0": {
        "type": "string"
      }
    }
  },
  "example": {
