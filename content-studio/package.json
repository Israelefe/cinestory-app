{
  "name": "veylo-content-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "start": "node scripts/start.mjs",
    "worker": "node src/server/worker.mjs",
    "knowledge:extract": "node scripts/extract-knowledge.mjs",
    "knowledge:check": "node scripts/extract-knowledge.mjs --check",
    "verify:motion-policy": "node scripts/verify-motion.mjs",
    "prebuild": "npm run verify:motion-policy",
    "build": "vite build --configLoader native",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test",
    "capture": "node scripts/capture.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "tools:install": "node scripts/install-tools.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/layout-utils": "4.0.527",
    "@remotion/player": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@remotion/transitions": "4.0.527",
    "archiver": "7.0.1",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "framer-motion": "11.0.8",
    "helmet": "8.3.0",
    "lucide-react": "0.359.0",
    "postcss": "8.5.29",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.527",
    "sharp": "0.35.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.5"
  },
  "overrides": {
    "qs": "6.16.0",
    "esbuild": "0.28.1"
  }
}
